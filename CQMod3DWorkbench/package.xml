<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
    <name>CQ Mod3D</name>
    <description>在终端中直接使用 cq_mod3d 编写代码操作 FreeCAD Part</description>
    <version>1.0.0</version>
    <date>2024-05-20</date>
    
    <maintainer>
        <name>Gang Wang</name>
        <!-- 你的 GitHub 主页或邮箱 -->
        <url>https://github.com/gwangcode/</url>
    </maintainer>
    
    <author>
        <name>Gang Wang</name>
    </author>
    
    <license file="LICENSE">MIT</license>
    
    <url type="repository" branch="main">https://github.com/gwangcode/CQMod3DWorkbench</url>
    
    <!-- 这里声明工作台的入口类，FreeCAD 会自动去 InitGui.py 找 -->
    <content>
        <workbench>
            <classname>CQMod3DWorkbench</classname>
        </workbench>
    </content>

    <!-- 可选：声明 Python 依赖，方便 FreeCAD 检查 -->
    <depend type="python" name="cadquery" optional="false"/>
</package>
