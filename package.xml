<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
    <name>Mod3D Workbench</name>
    <description>Interactive FreeCAD Python Terminal for Mod3D geometry generation and manipulation</description>
    <version>1.1.0</version>
    <date>2024-05-20</date>
    
    <maintainer>
        <name>Gang Wang</name>
        <url>https://github.com/gwangcode</url>
    </maintainer>
    
    <author>
        <name>Gang Wang</name>
    </author>
    
    <license file="LICENSE">MIT</license>
    
    <url type="repository" branch="main">https://github.com/gwangcode/Mod3DWorkbench</url>
    
    <content>
        <workbench>
            <classname>Mod3DWorkbench</classname>
        </workbench>
    </content>

    <depend type="python" name="numpy" optional="false"/>
    <depend type="python" name="scipy" optional="false"/>
    <depend type="python" name="trimesh" optional="false"/>
    <depend type="python" name="shapely" optional="false"/>
</package>
