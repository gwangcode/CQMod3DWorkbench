<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
    <name>Code3D Workbench</name>
    <description>Interactive FreeCAD Python Terminal for Code3D</description>
    <version>1.1.0</version>
    <date>2024-05-20</date>
    
    <maintainer>
        <name>Gang Wang</name>
        <email>gwangforward@gmail.com</email>
    </maintainer>
    
    <author>
        <name>Gang Wang</name>
    </author>
    
    <license file="LICENSE">MIT</license>
    
    <icon>Resources/Icons/Code3D.svg</icon>
    
    <url type="repository" branch="main">https://github.com/gwangcode/Code3D</url>
    
    <content>
        <workbench>
            <classname>Code3D</classname>
        </workbench>
    </content>

    <depend type="python" name="numpy" optional="false"/>
    <depend type="python" name="scipy" optional="false"/>
    <depend type="python" name="trimesh" optional="false"/>
    <depend type="python" name="shapely" optional="false"/>
</package>
